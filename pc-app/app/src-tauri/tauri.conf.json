{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DIY Sound Mixer",
  "version": "0.2.1",
  "identifier": "no.diysoundmixer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "visible": false,
        "dragDropEnabled": false,
        "title": "DIY Sound Mixer",
        "width": 1080,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560,
        "decorations": false,
        "shadow": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["acrylic"]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
